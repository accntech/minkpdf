{
	"name": "minkpdf",
	"version": "0.1.1",
	"description": "A standalone TypeScript PDF engine with zero package dependencies",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"files": [
		"dist",
		"src",
		"assets/icon.png",
		"docs"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/accntech/minkpdf.git"
	},
	"homepage": "https://github.com/accntech/minkpdf#readme",
	"bugs": "https://github.com/accntech/minkpdf/issues",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"docs:build": "bun scripts/build-docs.ts",
		"docs:dev": "bun run docs:build && bun scripts/serve-docs.ts",
		"docs:test": "bun test tests/docs.unit.test.ts",
		"prepack": "bun run build",
		"test": "bun test",
		"benchmark": "bun benchmarks/pdfmake.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./interfaces": {
			"types": "./src/interfaces.ts",
			"default": "./dist/interfaces.js"
		},
		"./core": {
			"types": "./src/core.ts",
			"default": "./dist/core.js"
		},
		"./tables": {
			"types": "./src/features/tables.ts",
			"default": "./dist/features/tables.js"
		},
		"./images": {
			"types": "./src/features/images.ts",
			"default": "./dist/features/images.js"
		},
		"./truetype": {
			"types": "./src/features/true-type.ts",
			"default": "./dist/features/true-type.js"
		}
	},
	"packageManager": "bun@1.4.2"
}
